5b:["$","p",null,{"className":"my-4 leading-7 text-foreground/90","children":["혹시 개드립이나 아재개그를 거부감 없이 환영하는 조직이 있다면 제게 연락 부탁드립니다 ",["$","del",null,{"children":"(진지함)"}],". 제 연락처는..."]}]
